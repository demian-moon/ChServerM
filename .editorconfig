root = true

# ChServerM 코드 스타일 및 분석기 정책
#
# 핵심 원칙: 성능·신뢰성 규칙은 error, 취향 규칙은 suggestion.
# 성능 규칙을 경고로 두면 결국 무시된다. 빌드를 깨야 지켜진다.

# 줄바꿈은 .gitattributes 와 반드시 일치시킨다. 두 파일이 다른 말을 하면
# 에디터가 쓴 것을 git 이 되돌리며 무한히 diff 가 뜬다.

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# .gitattributes 에서 CRLF 로 고정한 파일들 (Windows 셸 / .NET SDK 생성물)
[*.{cmd,bat,sln,slnx}]
end_of_line = crlf

[*.{json,yml,yaml,md}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ──────────────────────────────────────────────────────────────
[*.cs]

#### 분석기 카테고리 정책 ####

# 성능 — 이 프로젝트의 존재 이유다. 위반은 빌드 실패.
# CA1805(불필요한 초기화), CA1825(길이 0 배열 할당), CA1832/1833(AsSpan),
# CA1835(Memory 오버로드), CA1848(LoggerMessage), CA1859(구체 타입),
# CA1870(SearchValues 캐시) 등이 모두 여기 포함된다.
dotnet_analyzer_diagnostic.category-Performance.severity = error

# 신뢰성 — 리소스 누수, ArrayPool 미반납 계열. 레거시에서 실제로 터진 영역이다.
dotnet_analyzer_diagnostic.category-Reliability.severity = error

# 설계 — public API 표면에 직결된다. 프레임워크이므로 엄격히 본다.
dotnet_analyzer_diagnostic.category-Design.severity = warning

# 나머지는 참고용. 빌드를 막지 않는다.
dotnet_analyzer_diagnostic.category-Naming.severity = suggestion
dotnet_analyzer_diagnostic.category-Documentation.severity = suggestion
dotnet_analyzer_diagnostic.category-Globalization.severity = suggestion
dotnet_analyzer_diagnostic.category-Maintainability.severity = suggestion

# 위의 category- 일괄 설정은 기본 활성 규칙에는 적용되지 않는다(실측 확인).
# Naming 계열 중 실제로 걸리는 것은 아래처럼 개별로 명시한다.

# CA1711 — 금지 접미사 목록이 BCL 자신의 관례와 어긋나는 것들만 허용한다.
#   Collection: IFeatureCollection/FeatureCollection 은 ASP.NET Core 표준 명칭이고
#               타입 키 기반 조회라 ICollection 이 될 수 없다.
#   Flags:      BindingFlags/SocketFlags 등 BCL 의 [Flags] enum 관례와 같다.
#   Delegate:   ASP.NET Core RequestDelegate 와 같은 파이프라인 델리게이트 명칭.
dotnet_code_quality.CA1711.allowed_suffixes = Collection|Flags|Delegate

# CA1028 — enum 기반 타입을 int 로 올리라는 규칙.
# 이 프로젝트에서는 따를 수 없다.
#   FrameFlags 는 와이어 포맷 필드다 — ADR-0002 가 2바이트로 못박았다.
#   상태 enum(byte)은 구조체에 패킹돼 프레임당 복사 비용에 직접 들어간다.
# 규칙의 목적(다른 언어에서의 편의)보다 레이아웃 고정이 우선이다.
dotnet_diagnostic.CA1028.severity = none

# CA1716 — VB.NET 예약어(Get/Set 등)와의 이름 충돌.
# 이 프레임워크는 C# 전용이고, 규칙을 따르면 Features.Get<T>() 같은
# 관용 명칭을 쓸 수 없다. 나머지 Naming 규칙은 그대로 둔다.
dotnet_diagnostic.CA1716.severity = suggestion

# XML 문서 누락. Phase 1에서 Core 공개 API가 확정되면 warning으로 올린다.
dotnet_diagnostic.CS1591.severity = suggestion

#### 언어 규약 ####

# 파일 스코프 네임스페이스 — CLAUDE.md 규약
csharp_style_namespace_declarations = file_scoped:error

# var 는 우변에서 타입이 자명할 때만
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# using 은 명시적. ImplicitUsings=disable 과 짝을 이룬다.
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:error

# 불변성 우선
dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:warning
csharp_style_prefer_readonly_struct = true:warning
csharp_style_prefer_readonly_struct_member = true:warning

# 표현식 우선 (핫패스 가독성)
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_throw_expression = true:suggestion

# 패턴 매칭
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion

# 중괄호는 항상. 조건부 컴파일과 섞였을 때 사고를 막는다.
csharp_prefer_braces = true:warning

# 접근 수준 명시
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

#### 서식 ####
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_preserve_single_line_blocks = true

# ──────────────────────────────────────────────────────────────
# 테스트 — 프로덕션 규칙을 그대로 적용하지 않는다.
# 테스트는 의도를 드러내는 것이 성능보다 중요하다.
[Tests/**/*.cs]
dotnet_analyzer_diagnostic.category-Performance.severity = suggestion
dotnet_analyzer_diagnostic.category-Design.severity = suggestion
dotnet_diagnostic.CS1591.severity = none

# CA2007 — ConfigureAwait(false).
# 라이브러리 코드에는 계속 적용된다(CLAUDE.md 8절). 테스트 본문에는 적용하지 않는다:
# xUnit 은 동기화 컨텍스트를 설치하지 않으므로 효과가 없고, 단언마다 붙는 .ConfigureAwait(false)
# 가 테스트의 의도를 가린다.
dotnet_diagnostic.CA2007.severity = none

# CA2000 — 스코프를 벗어나기 전에 Dispose.
# 테스트 하네스는 소유권을 넘겨받아 IAsyncDisposable 로 정리한다.
# 분석기가 비동기 해제와 소유권 이전을 추적하지 못해 오탐이 난다.
dotnet_diagnostic.CA2000.severity = none

# CA5394 — System.Random 은 암호학적으로 안전하지 않다.
# 퍼징에서는 그것이 요구사항이다. 시드를 고정할 수 없으면 실패를 재현할 수 없고,
# 재현 안 되는 퍼징은 디버깅에 쓸모가 없다. 프로덕션 코드에는 계속 적용된다.
dotnet_diagnostic.CA5394.severity = none

# Method_name_with_underscores 는 테스트 명명 관례다.
dotnet_diagnostic.CA1707.severity = none

# ──────────────────────────────────────────────────────────────
# 샘플 — 사용자가 읽는 참조 코드다. 성능·신뢰성 규칙은 그대로 두고,
# 콘솔 애플리케이션에 맞지 않는 세 가지만 푼다.
[Samples/**/*.cs]

# CA2007 — ConfigureAwait(false) 는 라이브러리 규약이다(CLAUDE.md 8절).
# 애플리케이션 코드에는 적용되지 않고, 샘플에 붙어 있으면 읽는 사람이
# "앱에서도 필요하다"고 오해한다.
dotnet_diagnostic.CA2007.severity = none

# CA2000 — 전송과 실행 모델의 소유권은 ChServerMServer 로 넘어가고
# 그쪽 DisposeAsync 가 정리한다. 분석기가 비동기 소유권 이전을 추적하지 못한다.
dotnet_diagnostic.CA2000.severity = none

# CA1849 — 콘솔 출력에 WriteLineAsync 를 쓰라는 규칙.
# 샘플의 진행 상황 출력은 핫패스가 아니고, async 를 붙이면 예제가 읽기 어려워진다.
dotnet_diagnostic.CA1849.severity = none

# ──────────────────────────────────────────────────────────────
# 벤치마크 — BenchmarkDotNet 은 public 메서드/비봉인 클래스를 요구한다.
[Bench/**/*.cs]
dotnet_analyzer_diagnostic.category-Design.severity = suggestion
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CS1591.severity = none

# ──────────────────────────────────────────────────────────────
# 생성 코드 — 소스 제너레이터 산출물에는 규칙을 적용하지 않는다.
[*.{g,generated}.cs]
generated_code = true
