<?xml version="1.0" encoding="utf-8" ?>
<log4net>	
	<appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
		<file value="ServerLogs/serverlog.log" />	<!-- 로그 파일 경로 -->
		<appendToFile value="true" />		<!-- 기존 로그 파일에 추가 -->
		<rollingStyle value="Date" />		<!-- Date: 날짜기준, Size : 파일 크기기준 롤링 -->
    <datePattern value="'.'yyyyMMdd" />		<!-- 추가: 날짜 패턴 -->
		<maximumFileSize value="10MB" />	<!-- 최대 파일 크기 설정 -->
		<maxSizeRollBackups value="0" />	<!-- 최대 백업 파일 수 (0 무제한, 숫자3 쓰면 최신 순서로 3개만 유지하고 지운다) -->
		<staticLogFileName value="true" />	<!-- 동일한 파일 이름 사용 -->
		<encoding value="utf-8" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date{yyyy-MM-dd HH:mm:ss}&#9;%level&#9;%logger&#9;%message%newline" />
			<!-- 로그 형식 -->
		</layout>
				
		<immediateFlush value="false" />
		<!-- 즉시 flush 비활성화 (I/O 빈도 감소) -->
	</appender>

	<!-- 두 번째 Appender: UDP로 로그 전송 -->
	<appender name="UdpAppender" type="log4net.Appender.UdpAppender">
		<remoteAddress value="127.0.0.1" />
		<remotePort value="7001" />
    <encoding value="utf-8" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="[%logger] %date{yyyy-MM-dd HH:mm:ss} %level %message%newline" />
		</layout>
	</appender>
  <logger name="UdpLog">
    <level value="DEBUG" />
    <appender-ref ref="UdpAppender" />
  </logger>
	<root>
		<level value="DEBUG" />
		<appender-ref ref="RollingFileAppender" />
		<appender-ref ref="UdpAppender" />
	</root>
</log4net>




