<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / LangVersion / Nullable 등은 루트 Directory.Build.props 에서 온다. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- 테스트 어셈블리는 AOT 배포 대상이 아니다. 분석기 소음을 줄인다. -->
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    실제 CSV 를 AdditionalFiles 로 넘긴다 — 제너레이터가 **진짜 빌드에서** 헤더를 대조하는지
    확인하는 자리다(CHSM2011~2013). 파일 이름(확장자 제외)이 표 이름과 같아야 짝이 맞는다.
    같은 파일을 런타임에도 읽으므로(ReadFile) 죽은 픽스처가 아니다.
  -->
  <ItemGroup>
    <AdditionalFiles Include="Tables\*.csv" />
    <Content Include="Tables\*.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Server\ChServerM.DataTable\ChServerM.DataTable.csproj" />
    <!--
      데이터 테이블 접근자 제너레이터 — 분석기로만 참조한다(런타임 의존 아님).
      드라이버 테스트(SourceGen.Tests)와 달리 여기서는 **실제 빌드 파이프라인이 생성한 코드**를
      돌린다. 생성 문자열이 문법적으로 맞다는 것과, 그 코드가 실제로 옳게 읽는다는 것은 다르다.
    -->
    <ProjectReference Include="..\..\Server\ChServerM.SourceGen\ChServerM.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
