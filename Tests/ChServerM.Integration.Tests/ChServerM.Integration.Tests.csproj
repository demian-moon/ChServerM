<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / LangVersion / Nullable 등은 루트 Directory.Build.props 에서 온다. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- 테스트 어셈블리는 AOT 배포 대상이 아니다. 분석기 소음을 줄인다. -->
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <!--
      직렬화 축 교체 테스트용 메시지 생성기들. 런타임에는 아무것도 남지 않는다.
      FlatSharp.Compiler 는 net9.0 도구라 DOTNET_ROLL_FORWARD=LatestMajor 가 필요하다
      (eng/build.ps1 이 설정, ADR-0012).
    -->
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="FlatSharp.Compiler" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\swap_messages.proto" GrpcServices="None" />
    <FlatSharpSchema Include="Schemas\swap_messages.fbs" />
  </ItemGroup>

  <!--
    종단 테스트는 축을 실제로 조립한다.
    같은 핸들러가 서로 다른 축 조합에서 도는지 검증하는 것이 이 프로젝트의 목적이다(ADR-0004).
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Server\ChServerM.Compression.LZ4\ChServerM.Compression.LZ4.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Concurrency\ChServerM.Concurrency.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Framing\ChServerM.Framing.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Hosting\ChServerM.Hosting.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Observability\ChServerM.Observability.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Security.Tls\ChServerM.Security.Tls.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Serialization.FlatBuffers\ChServerM.Serialization.FlatBuffers.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Serialization.MemoryPack\ChServerM.Serialization.MemoryPack.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Serialization.Protobuf\ChServerM.Serialization.Protobuf.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Transport.InMemory\ChServerM.Transport.InMemory.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Transport.Tcp\ChServerM.Transport.Tcp.csproj" />
    <!-- 디스패치 소스 제너레이터 — 분석기로만 참조한다(런타임 의존 아님). -->
    <ProjectReference Include="..\..\Server\ChServerM.SourceGen\ChServerM.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
