<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / LangVersion / Nullable 등은 루트 Directory.Build.props 에서 온다. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- 테스트 어셈블리는 AOT 배포 대상이 아니다. 분석기 소음을 줄인다. -->
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <!-- CompilationWithAnalyzers 를 테스트 러너 안에서 직접 돌린다. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- 분석기는 타입으로 인스턴스화하는 직접 테스트다(SourceGen.Tests 와 같은 방식). 분석기 참조가 아니다. -->
    <ProjectReference Include="..\..\Server\ChServerM.Analyzers\ChServerM.Analyzers.csproj" />
    <!-- 테스트 컴파일레이션의 메타데이터 참조 원천(Core dll 경로 — MessageContext). -->
    <ProjectReference Include="..\..\Server\ChServerM.Core\ChServerM.Core.csproj" />
  </ItemGroup>

</Project>
