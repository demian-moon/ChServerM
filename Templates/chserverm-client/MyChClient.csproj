<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!--
    메타 패키지 하나가 realtime-stateful 최소 조합(ADR-0070)을 전부 가져온다 —
    클라이언트도 같은 프레이밍·디스패치 축을 쓴다(ClientBuilder 대칭 구성).
    사용 규약 분석기(CHSM3xxx)도 함께 온다.
  -->
  <ItemGroup>
    <PackageReference Include="ChServerM" Version="0.1.0" />
  </ItemGroup>

</Project>
