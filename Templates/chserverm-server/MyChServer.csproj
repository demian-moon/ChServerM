<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <!--
    메타 패키지 하나가 realtime-stateful 최소 조합(ADR-0070)을 전부 가져온다:
    Hosting·Framing·Concurrency·TCP·인메모리 전송·MemoryPack + 소스 제너레이터 +
    사용 규약 분석기(CHSM3xxx — 흔한 실수를 컴파일 타임에 잡는다).
    다른 축이 필요하면 ChServerM.* 개별 패키지를 추가·교체한다.
  -->
  <ItemGroup>
    <PackageReference Include="ChServerM" Version="0.1.0" />
  </ItemGroup>

</Project>
