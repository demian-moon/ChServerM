<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / LangVersion / Nullable 등은 루트 Directory.Build.props 에서 온다. -->

  <PropertyGroup>
    <RootNamespace>ChServerM.Serialization.FlatBuffers</RootNamespace>
    <Description>ChServerM 직렬화 축의 FlatSharp(FlatBuffers) 어댑터 (ADR-0012).</Description>
  </PropertyGroup>

  <!--
    런타임만 참조한다. 코드 생성(FlatSharp.Compiler)은 스키마를 가진 소비 프로젝트의
    빌드 타임 의존이다 — 이 어셈블리는 생성 타입을 ISerializer<T> 로만 받는다.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ChServerM.Core\ChServerM.Core.csproj" />
    <PackageReference Include="FlatSharp.Runtime" />
  </ItemGroup>

</Project>
