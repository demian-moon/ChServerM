<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / LangVersion / Nullable 등은 루트 Directory.Build.props 에서 온다. -->

  <PropertyGroup>
    <RootNamespace>ChServerM.Serialization.Protobuf</RootNamespace>
    <Description>ChServerM 직렬화 축의 Google.Protobuf 어댑터 (ADR-0012).</Description>
  </PropertyGroup>

  <!--
    벤더 격리 규약: 이 어셈블리의 public 표면에 노출되는 벤더 타입은
    제네릭 제약(IMessage<T>)뿐이다 — protobuf 생성 타입을 쓰려면 소비자도
    어차피 Google.Protobuf 를 알아야 하므로 이것은 유출이 아니라 전제다.
    Core 는 이 어셈블리를 몰라도 컴파일된다.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ChServerM.Core\ChServerM.Core.csproj" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

</Project>
