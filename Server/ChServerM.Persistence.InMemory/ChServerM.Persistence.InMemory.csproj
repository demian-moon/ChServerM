<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / LangVersion / Nullable 등은 루트 Directory.Build.props 에서 온다. -->

  <PropertyGroup>
    <RootNamespace>ChServerM.Persistence.InMemory</RootNamespace>
    <Description>ChServerM 세션 저장소 축(ISessionStore)의 인메모리 참조 구현. 낙관적 동시성(CAS) + 만료.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChServerM.Core\ChServerM.Core.csproj" />
  </ItemGroup>

  <!--
    벤더 의존 0. 이 어댑터는 BCL 만 쓴다 — 그래서 "참조 구현" 이다.
    두 번째 구현(Redis)이 나오기 전까지 ISessionStore 는 가설이고(CLAUDE.md 3절),
    이 프로젝트가 그 가설을 실행 가능한 형태로 고정한다.
  -->

</Project>
