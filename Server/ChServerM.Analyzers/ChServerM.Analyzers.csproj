<Project Sdk="Microsoft.NET.Sdk">

  <!-- LangVersion / Nullable 등은 루트 Directory.Build.props 에서 온다. -->

  <PropertyGroup>
    <!--
      분석기는 SDK 컴파일러 프로세스(및 IDE 분석기 호스트)에 로드된다.
      호스트 호환의 표준 타깃은 netstandard2.0 이다 (SourceGen 과 같은 이유).
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>ChServerM.Analyzers</RootNamespace>
    <Description>ChServerM 사용 규약 분석기 (Phase 20, ADR-0066) — 사용자의 흔한 실수를 컴파일 타임에 잡는다.</Description>

    <!-- 트리밍 분석은 netstandard2.0 을 지원하지 않는다. 분석기는 배포 대상도 아니다. -->
    <IsAotCompatible>false</IsAotCompatible>

    <!-- 분석기 저작 규칙(RS1036 등)을 켠다. -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <!--
    Core 를 참조하지 않는다 — 분석기는 소비 컴파일레이션을 메타데이터 이름 문자열로
    조사한다(SourceGen 과 같은 규약). 참조하면 분석기 로드 시 dll 해석 문제와 버전 결박이 생긴다.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- 진단 릴리스 추적(RS2008) — PublicAPI 승인 파일과 같은 목적의 diff 게이트다. -->
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <!--
    분석기 패키징(Phase 21): lib/ 가 아니라 analyzers/dotnet/cs 로 실린다 —
    소비 프로젝트의 컴파일러에 로드될 뿐 런타임 참조가 아니다.
    NU5128(lib 폴더 없음 경고)은 분석기 패키지의 정상 형태라 끈다.
  -->
  <PropertyGroup>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- lib/ 가 없는 패키지라 심볼 패키지(snupkg)가 비어 NU5017 로 터진다 - 분석기는 끈다. -->
    <IncludeSymbols>false</IncludeSymbols>
    <!-- 산출 경로는 정적 평가 시점에 비어 있으므로(OutputPath 는 targets 에서 확정) 타깃 훅으로 넣는다. -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalyzerAssets</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="PackAnalyzerAssets">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
