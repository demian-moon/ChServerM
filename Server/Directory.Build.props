<Project>

  <!--
    Server/ 아래 모든 프로젝트에만 적용되는 규약.
    루트 Directory.Build.props 를 먼저 가져와야 TargetFramework 등이 유지된다.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    ══════════════════════════════════════════════════════════════
    공개 API 승인 파일 게이트 (ROADMAP Phase 0)

    public 표면에 무엇이 추가·변경·삭제됐는지를 PublicAPI.*.txt 의 diff 로
    리뷰에 노출시킨다. 프레임워크가 산출물이므로 공개 표면 변경은
    "코드 변경"이 아니라 "제품 변경"이다.

    Shipped   : 릴리스된 API. 여기서 줄을 지우면 파괴적 변경이다
    Unshipped : 아직 릴리스되지 않은 API. 릴리스 때 Shipped 로 옮긴다

    ⚠ Tests/Bench/Samples 에는 적용하지 않는다. 그쪽의 public 은
      배포되는 API 가 아니라 테스트 러너·BenchmarkDotNet 이 요구하는 형태다.
    ══════════════════════════════════════════════════════════════
  -->
  <ItemGroup>
    <!--
      PrivateAssets="all" 이 필수다.

      이것을 빼면 ChServerM.Core 의 CHSM0001 가드가 "서드파티 의존"으로 판정해
      빌드를 막는다. 그 가드는 소비자에게 전파되는 의존만 문제 삼으므로,
      분석기처럼 전파되지 않는 것은 PrivateAssets="all" 로 명시해야 한다.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!--
    PublicAPI.*.txt 를 여기서 AdditionalFiles 로 넣지 않는다 — 패키지의
    buildTransitive targets 가 파일이 존재하면 자동 포함한다(5.6.0 실측).
    수동 포함은 중복 항목이 되어 DocFX metadata 가 프로젝트마다
    "Duplicate source file" 경고를 낸다(58건의 정체, 2026-08-12).
    ⚠ 제거가 게이트를 죽이지 않았음은 음성 테스트로 검증했다 — 미승인
    public 심볼을 임시로 추가하면 RS0016 이 여전히 발생한다.
  -->

  <!--
    ══════════════════════════════════════════════════════════════
    NuGet 패키징 공통 메타데이터 (Phase 21)

    버전은 루트 VersionPrefix 락스텝(ADR-0069). 패키지 ID = 어셈블리명,
    Description 은 각 csproj 가 진다(전 프로젝트 보유 확인, 2026-08-11).
    라이선스는 Apache-2.0 — 2026-08-12 사용자 확정(ADR-0071). 특허 허여·
    보복 조항과 상표 보호, 기여 조항(5조)이 채택 근거다. LICENSE·NOTICE 는
    저장소 루트가 정본이고 모든 패키지에 동봉된다(4조 (d) NOTICE 재배포 규정).
    ══════════════════════════════════════════════════════════════
  -->
  <PropertyGroup>
    <Authors>ChServerM</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>Copyright 2026 The ChServerM Authors</Copyright>
    <RepositoryUrl>https://github.com/demian-moon/ChServerM</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/demian-moon/ChServerM</PackageProjectUrl>
    <!-- SDK 내장 SourceLink 가 RepositoryUrl·커밋을 심는다. 심볼은 snupkg 로 분리 발행. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- 패키지 구조 검증(다중 타깃·의존 일관성). 릴리스 후 baseline 비교로 확장한다(Phase 21). -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- LICENSE·NOTICE 를 모든 패키지에 동봉한다 — Apache-2.0 4조 (a)/(d). -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
