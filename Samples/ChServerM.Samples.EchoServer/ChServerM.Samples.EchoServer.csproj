<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / LangVersion / Nullable 등은 루트 Directory.Build.props 에서 온다. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ChServerM.Samples.EchoServer</RootNamespace>
    <IsPackable>false</IsPackable>

    <!--
      이 프로젝트가 존재하는 두 번째 이유가 이것이다.

      라이브러리에 IsAotCompatible=true 를 걸면 분석기가 리플렉션 유입을 잡아주지만,
      실제로 Native AOT 로 링크되는지는 확인해 주지 않는다. 실행 가능 프로젝트를
      publish 해봐야 트리밍 경고와 링크 실패가 드러난다.

      Phase 0 의 "AOT 검증" 항목이 지금까지 SKIPPED 였던 이유가 대상 프로젝트의 부재였다.
    -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>false</StackTraceSupport>

    <!-- 트리밍/AOT 경고를 오류로 승격한다. 경고로 두면 결국 쌓인다. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>

    <!--
      ⚠ MemoryPack 라이브러리 내부의 리플렉션 폴백 경로(MemoryPackFormatterProvider 의
      MakeGenericType/Activator/GetMethod)가 ILC 정적 분석에 걸린다. 우리 메시지 타입은
      소스 생성 포매터가 정적 생성자에서 등록되므로 그 폴백이 실행되지 않지만(ADR-0011),
      ILC 는 이를 증명할 수 없다 — 라이브러리 소유 경고라 우리가 고칠 수도 없다.
      해당 코드만 좁게 억제하고, 반대급부로 eng/build.ps1 의 AOT 단계가 publish 된
      바이너리를 실제로 실행해 자체 검증(exit 0)까지 요구한다 — 정적 증명 대신 실행 증명.
      우리 코드의 새 트리밍 결함은 여전히 이 목록 밖 경고로 잡힌다.
    -->
    <NoWarn>$(NoWarn);IL2055;IL2057;IL2060;IL2070;IL2072;IL2090;IL2091;IL3050</NoWarn>
  </PropertyGroup>

  <!--
    realtime-stateful 참조 프로필의 최소 조합(ADR-0004):
      TCP + 고정 헤더 프레이밍 + 키 기반 파티션 실행 모델
    같은 핸들러를 인메모리 전송으로도 돌려 조립 가능성을 실증한다.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Server\ChServerM.Concurrency\ChServerM.Concurrency.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Framing\ChServerM.Framing.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Hosting\ChServerM.Hosting.csproj" />
    <!-- 기본 직렬화기(ADR-0013) — 생성 등록 경로의 제공자로 쓴다. -->
    <ProjectReference Include="..\..\Server\ChServerM.Serialization.MemoryPack\ChServerM.Serialization.MemoryPack.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Transport.InMemory\ChServerM.Transport.InMemory.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Transport.Tcp\ChServerM.Transport.Tcp.csproj" />
    <!--
      디스패치 소스 제너레이터 — 분석기로만 참조(런타임 의존 아님).
      이 샘플의 AOT publish 가 곧 "생성 코드 경로의 AOT 동작" 게이트 증명이다(Phase 7).
    -->
    <ProjectReference Include="..\..\Server\ChServerM.SourceGen\ChServerM.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- 사용 규약 분석기(CHSM3xxx, ADR-0066) — 샘플이 첫 소비자다. -->
    <ProjectReference Include="..\..\Server\ChServerM.Analyzers\ChServerM.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
