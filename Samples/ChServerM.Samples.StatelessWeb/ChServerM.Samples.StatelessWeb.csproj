<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / LangVersion / Nullable 등은 루트 Directory.Build.props 에서 온다. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ChServerM.Samples.StatelessWeb</RootNamespace>
    <IsPackable>false</IsPackable>

    <!--
      protoc 생성 코드가 트리밍 분석기 소음을 만들어 분석만 끈다 —
      Serialization.Protobuf 어댑터 자체는 자기 프로젝트의 IsAotCompatible 로 검증된다.
    -->
    <IsAotCompatible>false</IsAotCompatible>

    <!--
      Phase 22: 샘플 전체가 Native AOT 검증 대상이다 — "게이트는 EchoServer 하나"에서
      확대됐다. eng/build.ps1 의 AOT 단계가 이 선언을 발견해 publish + 실행(자체 검증
      exit 0)까지 게이트한다. 분석(IsAotCompatible)은 꺼져 있어도 실제 링크·실행이
      성공하는지는 publish 가 증명한다 — 정적 증명 대신 실행 증명(EchoServer 와 같은 원칙).
    -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- protoc 빌드 타임 코드 생성. 런타임에는 아무것도 남지 않는다. -->
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\stateless_web.proto" GrpcServices="None" />
  </ItemGroup>

  <!--
    stateless-web 참조 프로필의 최소 조합(ADR-0004):
      HTTP/2 + 고정 헤더 프레이밍 + 병렬(스레드풀) 실행 + Protobuf
    EchoServer(realtime-stateful)와 같은 핸들러 작성 방식이 이 조합에서도 동작하는 것이
    조립 가능성의 합격 기준이다.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Server\ChServerM.Framing\ChServerM.Framing.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Hosting\ChServerM.Hosting.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Serialization.Protobuf\ChServerM.Serialization.Protobuf.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Transport.Http\ChServerM.Transport.Http.csproj" />
    <!-- 디스패치 소스 제너레이터 — 분석기로만 참조(런타임 의존 아님). -->
    <ProjectReference Include="..\..\Server\ChServerM.SourceGen\ChServerM.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- 사용 규약 분석기(CHSM3xxx, ADR-0066) — 샘플이 첫 소비자다. -->
    <ProjectReference Include="..\..\Server\ChServerM.Analyzers\ChServerM.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
