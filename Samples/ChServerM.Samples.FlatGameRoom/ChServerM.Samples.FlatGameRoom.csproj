<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / LangVersion / Nullable 등은 루트 Directory.Build.props 에서 온다. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ChServerM.Samples.FlatGameRoom</RootNamespace>
    <IsPackable>false</IsPackable>

    <!--
      FlatSharp 생성 코드는 public 타입인데 XML 문서가 없다 — 샘플 실행 파일은 API 문서
      산출물이 아니므로 문서 생성을 끈다(FlatBuffers 테스트 프로젝트와 같은 판단).
    -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      FlatSharp 생성 코드가 트리밍/AOT 분석기 소음을 만들 수 있어 분석만 끈다 —
      StatelessWeb(protoc 생성 코드)과 같은 판단. 실제 링크·실행 가능성은 아래 PublishAot
      게이트가 publish + 자체 검증 실행(exit 0)이라는 실행 증명으로 담보한다.
    -->
    <IsAotCompatible>false</IsAotCompatible>

    <!--
      Phase 22: 샘플 전체가 Native AOT 검증 대상이다. eng/build.ps1 의 AOT 단계가 이 선언을
      발견해 publish + 실행(자체 검증 exit 0)까지 게이트한다. 전역 속성 전달은 netstandard2.0
      분석기에서 NETSDK1207 로 터지므로 프로젝트 자신이 선언한다(build.ps1 주석 참조).
    -->
    <PublishAot>true</PublishAot>

    <!--
      ⚠ FlatSharp 생성 코드의 [DynamicDependency] 가 어셈블리 한정 없는 타입 이름 문자열을
      써서 IL2122 가 난다 — 대상 타입이 같은 어셈블리에 있어 링크는 실제로 성립하지만
      ILC 정적 분석은 이를 증명하지 못하고, 라이브러리 소유 생성 코드라 우리가 고칠 수도 없다.
      해당 진단만 좁게 억제하고, 반대급부로 AOT publish + 자체 검증 실행이 실행 증명을 맡는다
      (EchoServer 의 MemoryPack IL2xxx 억제와 같은 판단). 우리 코드의 새 트리밍 결함은
      여전히 이 목록 밖 경고로 잡힌다.
    -->
    <NoWarn>$(NoWarn);IL2122</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      fbs 빌드 타임 코드 생성. 런타임에는 FlatSharp.Runtime 만 남는다(어댑터가 전이 제공).
      ⚠ 이 컴파일러는 net9.0 도구다 — .NET 10 SDK 만 있는 환경(이 저장소 표준)에서는
      DOTNET_ROLL_FORWARD=LatestMajor 가 필요하다. eng/build.ps1 이 설정해 주므로
      IDE 단독 빌드가 실패하면 그 환경 변수를 켜라 (ADR-0012).
    -->
    <PackageReference Include="FlatSharp.Compiler" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <FlatSharpSchema Include="Schemas\flat_game_room.fbs" />
  </ItemGroup>

  <!--
    FlatBuffers 게임 룸 예제의 조합:
      TCP + 고정 헤더 프레이밍 + 파티션 실행 모델(realtime-stateful, ADR-0004)
      + FlatSharp 직렬화 + 인증/상태 필터 미들웨어 + 세션(재개 토큰, InMemory)
      + 룸/브로드캐스트(선택 축, Phase 18)
    룸 축은 커넥션 파티션의 배타 슬롯을 소유권 근거로 쓰므로(ADR-0064)
    파티션 실행 모델과 함께 조립하는 것이 전제다.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Server\ChServerM.Concurrency\ChServerM.Concurrency.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Framing\ChServerM.Framing.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Hosting\ChServerM.Hosting.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Persistence.InMemory\ChServerM.Persistence.InMemory.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.RealTime.Rooms\ChServerM.RealTime.Rooms.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Serialization.FlatBuffers\ChServerM.Serialization.FlatBuffers.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Transport.Tcp\ChServerM.Transport.Tcp.csproj" />
    <!--
      디스패치 소스 제너레이터 — 분석기로만 참조(런타임 의존 아님).
      [MessageHandler] 선언에서 MapGeneratedHandlers 등록 코드를 생성한다(ADR-0014).
    -->
    <ProjectReference Include="..\..\Server\ChServerM.SourceGen\ChServerM.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- 사용 규약 분석기(CHSM3xxx, ADR-0066) — 페이로드 수명 위반을 빌드 시점에 잡는다. -->
    <ProjectReference Include="..\..\Server\ChServerM.Analyzers\ChServerM.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
