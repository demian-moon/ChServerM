<Project>

  <!--
    모든 ChServerM 프로젝트의 공통 컴파일 규약.
    여기서 정한 값이 이후 모든 성능 작업의 전제가 된다. 개별 csproj에서 재정의하지 않는다.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>

    <!-- 프레임워크 코드는 의존성이 명시적이어야 한다. 암묵적 using은 쓰지 않는다. -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- 핫패스에서 Span/포인터/MemoryMarshal을 쓴다. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- public API 문서가 제품의 일부다. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      AOT/트리밍 분석기를 켜는 장치.
      런타임 리플렉션이 유입되면 컴파일 타임에 경고로 잡힌다 — 이것이 목적이고,
      실제 Native AOT 배포 여부와는 별개다.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 결정적 빌드 — 벤치마크 재현성의 전제. -->
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    런타임 GC/JIT 설정. 라이브러리에는 영향이 없고 실행 가능 프로젝트의
    runtimeconfig.json 에만 반영된다.

    ⚠ 프로퍼티 이름은 `...Collection` 이다 (`...Collector` 가 아니다).
    2026-08-08 까지 `ServerGarbageCollector`/`ConcurrentGarbageCollector` 로 적혀 있었는데
    그것은 **SDK 에 존재하지 않는 이름**이라 MSBuild 가 조용히 무시했다 — 선언은 있었지만
    runtimeconfig.json 에 `System.GC.Server` 가 실리지 않아 **모든 실행 파일이 Workstation GC
    로 돌았다**(실측: `GCSettings.IsServerGC == false`). 오타 하나가 "고정" 이라고 문서화된
    설정을 통째로 무효화한 사례다.

    설정이 실제로 걸렸는지는 **runtimeconfig.json 을 보고 확인한다** — 선언을 믿지 않는다:
      grep '"System.GC' <프로젝트>/bin/Release/net10.0/*.runtimeconfig.json
  -->
  <PropertyGroup>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

</Project>
