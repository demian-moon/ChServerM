<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / LangVersion / Nullable 등은 루트 Directory.Build.props 에서 온다. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ChServerM.Bench</RootNamespace>
    <IsPackable>false</IsPackable>

    <!--
      벤치마크는 AOT 배포 대상이 아니다. BenchmarkDotNet 이 런타임에 벤치마크
      실행 프로젝트를 생성·컴파일하므로 AOT 분석기와 맞지 않는다.
    -->
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      BenchmarkDotNet 은 최적화가 켜져 있지 않으면 경고하고 결과를 신뢰하지 말라고 알린다.
      Debug 로 실수로 돌리는 것을 막기 위해 여기서 고정한다.
    -->
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>

    <!-- 서버 GC 로 측정한다. 워크로드 GC 특성이 완전히 달라지므로 프로덕션과 맞춘다. -->
    <ServerGarbageCollector>true</ServerGarbageCollector>
    <ConcurrentGarbageCollector>true</ConcurrentGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- 벤치 메시지 타입([MemoryPackable]) 생성기 — 어댑터 참조로는 생성기가 전파되지 않는다. -->
    <PackageReference Include="MemoryPack" />
    <!--
      MessagePack 은 4자 벤치마크 비교군 전용이다(ADR-0012). 어댑터 어셈블리가 없으므로
      벤치 안의 최소 래퍼로 돌린다 — 표준 리졸버(IL emit) 경로라 JIT 전용이다.
    -->
    <PackageReference Include="MessagePack" />
    <!-- 빌드 타임 코드 생성기. FlatSharp.Compiler 는 DOTNET_ROLL_FORWARD 필요(eng/build.ps1). -->
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="FlatSharp.Compiler" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Serialization\bench_messages.proto" GrpcServices="None" />
    <FlatSharpSchema Include="Serialization\bench_messages.fbs" />
  </ItemGroup>

  <!--
    측정 대상. 벤치마크는 프로덕션 조립과 같은 경로를 써야 의미가 있다 —
    벤치마크용 지름길을 만들면 그 수치는 프로덕션을 대표하지 않는다.
    직렬화 벤치가 어댑터(IMessageSerializer 구현)를 통해 도는 것도 같은 이유다.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Server\ChServerM.Buffers\ChServerM.Buffers.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Compression.LZ4\ChServerM.Compression.LZ4.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Concurrency\ChServerM.Concurrency.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Framing\ChServerM.Framing.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Hosting\ChServerM.Hosting.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Observability\ChServerM.Observability.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Persistence.InMemory\ChServerM.Persistence.InMemory.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Serialization.FlatBuffers\ChServerM.Serialization.FlatBuffers.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Serialization.MemoryPack\ChServerM.Serialization.MemoryPack.csproj" />
    <ProjectReference Include="..\..\Server\ChServerM.Serialization.Protobuf\ChServerM.Serialization.Protobuf.csproj" />
  </ItemGroup>

</Project>
