<Project>

  <!--
    중앙 패키지 버전 관리.
    개별 csproj는 <PackageReference Include="..."/> 만 쓰고 Version 을 적지 않는다.
    버전은 전부 여기서 결정한다.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />

    <!--
      통합 테스트용 Redis 컨테이너. Docker 가 없는 환경에서는 해당 테스트를 건너뛴다
      (개발 머신마다 Docker 를 강제하지 않는다. CI 의 ubuntu 러너에는 있다).
    -->
    <PackageVersion Include="Testcontainers.Redis" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />

    <!--
      Consul 은 Testcontainers 모듈이 없어 범용 ContainerBuilder 로 띄운다
      (Garnet 과 같은 판단). 그래서 기반 패키지를 직접 참조한다.
    -->
    <PackageVersion Include="Testcontainers" Version="4.13.0" />

    <!--
      ⚠ 취약점 대응 전이 고정 — SSH.NET 은 Testcontainers 의 전이 의존이다(직접 사용 없음).
      2025.1.0 에 High 권고(GHSA-q939-rpr3-3284)가 공표되어 audit 게이트가 잡았다(2026-08-18).
      CentralPackageTransitivePinningEnabled 가 이 선언으로 전이 그래프를 패치판으로 올린다.
      Testcontainers 가 자체적으로 패치판 이상을 요구하게 되면 이 줄은 제거한다.
    -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />

    <!--
      xUnit 2.x 에는 동적 건너뛰기(Assert.Skip)가 없다 — v3 기능이다.
      적합성 스위트는 **백킹 저장소가 없으면 건너뛴다** 는 의미가 필요하므로 이것을 쓴다:
      Docker 가 없는 개발 머신과 CI 의 windows-latest(리눅스 컨테이너 불가)에서
      Redis 테스트가 실패가 아니라 건너뜀이 되어야 한다.
    -->
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <!--
      로깅 축의 어댑터 대상 (Phase 11, ADR-0030).

      ⚠ ZLogger 를 직접 참조하지 않는 이유: IServerLogger.Log&lt;TState&gt; 의 시그니처가
      ILogger.Log&lt;TState&gt; 와 동일하므로, MEL 추상화 하나로 ZLogger·Serilog·콘솔·Seq 등
      생태계 전체가 열린다. ZLogger 를 직접 물면 벤더 하나에 묶이면서 얻는 것이 없다 —
      ZLogger 의 방출 시점 무할당 경로는 상태 타입이 ZLogger 인터페이스를 구현해야 해서
      Core 에 벤더가 스며든다(하드 룰 위반). 상세는 ADR-0030.

      Abstractions 만 참조한다 — 구현(Microsoft.Extensions.Logging)은 호스트가 고른다.
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <!--
      구현체는 **테스트 전용**이다 — 런타임 로그 레벨 변경이 어댑터를 통과하는지
      실제 LoggerFactory 로 검증하려면 필터 옵션을 바꿀 수 있어야 한다.
      프로덕션 어댑터 어셈블리는 Abstractions 만 참조한다.
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <!--
      공개 API 승인 파일 게이트.

      public 표면에 무엇이 추가·변경·삭제됐는지를 PublicAPI.*.txt 의 diff 로 드러낸다.
      상업용 라이브러리에서 이것을 나중에 켜면 이미 굳은 API 를 되돌릴 수 없다 —
      그래서 표면이 작을 때 켠다 (ROADMAP Phase 0).
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="DataTable">
    <!--
      안정 해시(XxHash128) — 콘텐츠 지문 계산용 (Phase 14, ADR-0044).
      ⚠ `string.GetHashCode` 를 쓸 수 없다: .NET 의 문자열 해시는 프로세스마다 시드가 달라
      **같은 데이터가 실행할 때마다 다른 값**이 된다. 클라이언트와 서버가 대조할 값이므로
      프로세스·플랫폼·런타임 버전을 가로질러 같아야 한다.
      CLAUDE.md 6절이 이미 `System.IO.Hashing.XxHash3` 를 스택으로 지목해 뒀다.
    -->
    <!--
      10.0.5 인 이유: StackExchange.Redis 3.1.13 이 이미 이 패키지를 10.0.5 이상으로 끌어온다.
      중앙 버전이 그보다 낮으면 다운그레이드(NU1109)로 복원이 막힌다.
    -->
    <PackageVersion Include="System.IO.Hashing" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup Label="SourceGen">
    <!--
      디스패치 소스 제너레이터 (Phase 7, ADR-0014).
      ⚠ 4.14 로 고정하는 이유: 생성기는 SDK 의 컴파일러 프로세스에 로드되므로
      호스트 컴파일러보다 새 Roslyn API 를 참조하면 로드에 실패한다.
      SDK 10.0.1xx 의 호스트(5.x)보다 낮은 버전이 하위호환의 안전선이다.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>

  <ItemGroup Label="Benchmark">
    <!--
      BenchmarkDotNet 은 벤치마크를 별도 프로세스로 격리해 돌린다.
      그래서 "Release 빌드, 디버거 미연결"(docs/BENCHMARKS.md 규칙)이 자동으로 보장된다.
      직접 Stopwatch 로 재는 것과 이 점이 다르다.
    -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup Label="Serialization">
    <!--
      직렬화 축 어댑터 (Phase 6).
      MemoryPack: 첫 어댑터(ADR-0011). Google.Protobuf + FlatSharp: 잔여 어댑터(ADR-0012).
      기본값 확정은 4자 벤치마크 후 별도 ADR — "도입"과 "기본값"은 다른 결정이다.
    -->
    <PackageVersion Include="MemoryPack" Version="1.21.4" />
    <PackageVersion Include="Google.Protobuf" Version="3.35.1" />
    <PackageVersion Include="FlatSharp.Runtime" Version="7.9.0" />
    <!-- 빌드 타임 코드 생성기 — 소비 프로젝트에서 PrivateAssets="all" 로 쓴다. -->
    <PackageVersion Include="Grpc.Tools" Version="2.83.0" />
    <PackageVersion Include="FlatSharp.Compiler" Version="7.9.0" />
    <!--
      MessagePack 은 4자 벤치마크 비교군 전용이다(Bench 만 참조).
      어댑터 어셈블리는 만들지 않는다 — 근거는 ADR-0012.
    -->
    <PackageVersion Include="MessagePack" Version="3.1.8" />
  </ItemGroup>

  <ItemGroup Label="Compression">
    <!--
      압축 축 어댑터 (Phase 9, ADR-0019).
      K4os = .NET LZ4 의 사실상 표준 관리형 구현(AOT 호환). 비교군 Brotli 는 BCL.
    -->
    <PackageVersion Include="K4os.Compression.LZ4" Version="1.3.8" />

    <!--
      세션 저장소 축(ISessionStore)의 두 번째 구현. ADR-0034.
      벤더는 ChServerM.Persistence.Redis 어셈블리에만 존재한다 — Core 는 모른다.
    -->
    <PackageVersion Include="StackExchange.Redis" Version="3.1.13" />

    <!--
      세션 저장소 축의 세 번째 구현 — 관계형. ADR-0037.
      벤더는 ChServerM.Persistence.Postgres 어셈블리에만 존재한다.
    -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Security">
    <!--
      비밀번호 해싱 어댑터 (Phase 9, ADR-0018).
      PasswordHasher<T> = PBKDF2-HMAC-SHA256 + 비밀번호별 랜덤 솔트 + 버전 태그 형식.
      레거시 AuthM 이 쓰던 것과 같은 라이브러리라 기존 계정 해시와 형식 호환된다.
    -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.10" />
  </ItemGroup>

  <!--
    축 어댑터 패키지는 해당 Phase에 진입할 때 추가한다.
    ADR 없이 여기에 항목을 늘리지 않는다 — docs/DECISIONS.md 참조.
      Transport     : Microsoft.AspNetCore.Connections.Abstractions
      Observability : ZLogger / OpenTelemetry
      Load test     : NBomber
  -->

</Project>
