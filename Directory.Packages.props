<Project>

  <!--
    중앙 패키지 버전 관리.
    개별 csproj는 <PackageReference Include="..."/> 만 쓰고 Version 을 적지 않는다.
    버전은 전부 여기서 결정한다.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <!--
      공개 API 승인 파일 게이트.

      public 표면에 무엇이 추가·변경·삭제됐는지를 PublicAPI.*.txt 의 diff 로 드러낸다.
      상업용 라이브러리에서 이것을 나중에 켜면 이미 굳은 API 를 되돌릴 수 없다 —
      그래서 표면이 작을 때 켠다 (ROADMAP Phase 0).
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="SourceGen">
    <!--
      디스패치 소스 제너레이터 (Phase 7, ADR-0014).
      ⚠ 4.14 로 고정하는 이유: 생성기는 SDK 의 컴파일러 프로세스에 로드되므로
      호스트 컴파일러보다 새 Roslyn API 를 참조하면 로드에 실패한다.
      SDK 10.0.1xx 의 호스트(5.x)보다 낮은 버전이 하위호환의 안전선이다.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>

  <ItemGroup Label="Benchmark">
    <!--
      BenchmarkDotNet 은 벤치마크를 별도 프로세스로 격리해 돌린다.
      그래서 "Release 빌드, 디버거 미연결"(docs/BENCHMARKS.md 규칙)이 자동으로 보장된다.
      직접 Stopwatch 로 재는 것과 이 점이 다르다.
    -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup Label="Serialization">
    <!--
      직렬화 축 어댑터 (Phase 6).
      MemoryPack: 첫 어댑터(ADR-0011). Google.Protobuf + FlatSharp: 잔여 어댑터(ADR-0012).
      기본값 확정은 4자 벤치마크 후 별도 ADR — "도입"과 "기본값"은 다른 결정이다.
    -->
    <PackageVersion Include="MemoryPack" Version="1.21.4" />
    <PackageVersion Include="Google.Protobuf" Version="3.35.1" />
    <PackageVersion Include="FlatSharp.Runtime" Version="7.9.0" />
    <!-- 빌드 타임 코드 생성기 — 소비 프로젝트에서 PrivateAssets="all" 로 쓴다. -->
    <PackageVersion Include="Grpc.Tools" Version="2.83.0" />
    <PackageVersion Include="FlatSharp.Compiler" Version="7.9.0" />
    <!--
      MessagePack 은 4자 벤치마크 비교군 전용이다(Bench 만 참조).
      어댑터 어셈블리는 만들지 않는다 — 근거는 ADR-0012.
    -->
    <PackageVersion Include="MessagePack" Version="3.1.8" />
  </ItemGroup>

  <ItemGroup Label="Compression">
    <!--
      압축 축 어댑터 (Phase 9, ADR-0019).
      K4os = .NET LZ4 의 사실상 표준 관리형 구현(AOT 호환). 비교군 Brotli 는 BCL.
    -->
    <PackageVersion Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>

  <ItemGroup Label="Security">
    <!--
      비밀번호 해싱 어댑터 (Phase 9, ADR-0018).
      PasswordHasher<T> = PBKDF2-HMAC-SHA256 + 비밀번호별 랜덤 솔트 + 버전 태그 형식.
      레거시 AuthM 이 쓰던 것과 같은 라이브러리라 기존 계정 해시와 형식 호환된다.
    -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.10" />
  </ItemGroup>

  <!--
    축 어댑터 패키지는 해당 Phase에 진입할 때 추가한다.
    ADR 없이 여기에 항목을 늘리지 않는다 — docs/DECISIONS.md 참조.
      Transport     : Microsoft.AspNetCore.Connections.Abstractions
      Observability : ZLogger / OpenTelemetry
      Load test     : NBomber
  -->

</Project>
