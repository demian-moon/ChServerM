<Project>

  <!--
    중앙 패키지 버전 관리.
    개별 csproj는 <PackageReference Include="..."/> 만 쓰고 Version 을 적지 않는다.
    버전은 전부 여기서 결정한다.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <!--
      공개 API 승인 파일 게이트.

      public 표면에 무엇이 추가·변경·삭제됐는지를 PublicAPI.*.txt 의 diff 로 드러낸다.
      상업용 라이브러리에서 이것을 나중에 켜면 이미 굳은 API 를 되돌릴 수 없다 —
      그래서 표면이 작을 때 켠다 (ROADMAP Phase 0).
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Benchmark">
    <!--
      BenchmarkDotNet 은 벤치마크를 별도 프로세스로 격리해 돌린다.
      그래서 "Release 빌드, 디버거 미연결"(docs/BENCHMARKS.md 규칙)이 자동으로 보장된다.
      직접 Stopwatch 로 재는 것과 이 점이 다르다.
    -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!--
    축 어댑터 패키지는 해당 Phase에 진입할 때 추가한다.
    ADR 없이 여기에 항목을 늘리지 않는다 — docs/DECISIONS.md 참조.
      Serialization : MemoryPack / Google.Protobuf / FlatSharp
      Transport     : Microsoft.AspNetCore.Connections.Abstractions
      Observability : ZLogger / OpenTelemetry
      Load test     : NBomber
  -->

</Project>
