{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../../Server",
          "files": [ "*/*.csproj" ],
          "exclude": [
            "ChServerM.SourceGen/**",
            "ChServerM.Analyzers/**"
          ]
        }
      ],
      "dest": "api",
      "outputFormat": "mref",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      { "files": [ "api/**.yml", "api/index.md" ] },
      { "files": [ "toc.yml", "index.md" ] }
    ],
    "resource": [],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "ChServerM",
      "_appTitle": "ChServerM API",
      "_enableSearch": true,
      "pdf": false
    }
  }
}
